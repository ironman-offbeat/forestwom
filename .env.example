# Server-only Vercel Production environment variables. Never use VITE_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ADMIN_KEY=
# Prefer Vercel Connect. The connected Slack app needs chat:write for owner notifications.
SLACK_CONNECTOR=
# Optional fallback when a dedicated Slack app is manually installed.
SLACK_BOT_TOKEN=
